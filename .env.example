# SQLite (로컬 개발). 프로덕션에서는 PostgreSQL URL로 교체하고 schema provider를 변경하세요.
DATABASE_URL="file:./dev.db"

# Auth.js — openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-use-openssl-rand"

# Google Cloud Console OAuth 클라이언트
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 선택: AUTH_URL=http://localhost:3000
