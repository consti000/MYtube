# PostgreSQL — 로컬(Docker/Neon) 또는 Vercel Postgres / Neon
# 예: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon 사용 시: migrate용 Direct(non-pooling) URL 권장 (pooler면 P1002 잠금 타임아웃)
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# 또는 Vercel Postgres가 넣는 POSTGRES_URL_NON_POOLING 도 동일 역할

# Auth.js — openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-use-openssl-rand"

# Google Cloud Console OAuth 클라이언트 (Gmail/비밀번호 아님!)
# 로컬: http://localhost:3000/api/auth/callback/google
# Vercel: https://YOUR-PROJECT.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 로컬
AUTH_URL="http://localhost:3000"
# Vercel 배포 후 (반드시 https, 끝 / 없이):
# AUTH_URL="https://YOUR-PROJECT.vercel.app"
# AUTH_TRUST_HOST="true"

# Google Gemini — 재생 패널 영상 요약 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# 선택: 기본 gemini-2.0-flash
# GEMINI_MODEL="gemini-2.0-flash"
